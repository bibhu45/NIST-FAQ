<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>NIST FAQ | AI-Powered Solutions</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top left, #0d0d1a, #11112b, #0a0a14);
            min-height: 100vh;
            color: white;
            overflow-x: hidden;
        }

        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 28px;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-glow {
            text-shadow: 0 0 20px rgba(129, 140, 248, 0.5);
        }
    </style>
</head>

<body class="p-4 md:p-8">

    <!-- Navigation -->
    <nav class="max-w-6xl mx-auto flex justify-between items-center mb-16">

        <!-- Logo -->
        <div class="text-3xl font-extrabold tracking-widest flex items-center gap-2 logo-glow">
            <i data-lucide="shield" class="text-indigo-400 fill-indigo-400/20"></i>
            NIST FAQ
        </div>

        <!-- Menu -->
        <div class="hidden md:flex gap-10 text-sm font-semibold text-gray-400">
            <a href="#" class="hover:text-white transition-all">Admissions</a>
            <a href="#" class="hover:text-white transition-all">Courses</a>
            <a href="#" class="hover:text-white transition-all">Placements</a>
        </div>

        <!-- Button -->
        <button
            class="bg-indigo-600 px-6 py-2 rounded-xl font-bold text-sm hover:bg-indigo-500 shadow-lg shadow-indigo-500/20 transition-all">
            Contact
        </button>

    </nav>

    <!-- Main Section -->
    <main class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left Side -->
        <div class="space-y-8">

            <div
                class="inline-block px-4 py-1 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-400 text-xs font-bold tracking-widest uppercase">
                Welcome to NIST University
            </div>

            <h1 class="text-7xl md:text-8xl font-black leading-none">
                Smart <br>
                <span class="hero-gradient">FAQ Chatbot.</span>
            </h1>

            <p class="text-gray-400 text-xl max-w-md leading-relaxed font-light">
                Get instant answers about admissions, courses, hostel, placements,
                scholarships, and campus facilities through our AI-powered chatbot.
            </p>

            <div class="flex gap-6">

                <button
                    class="flex items-center gap-3 bg-white text-black px-8 py-4 rounded-2xl font-bold hover:bg-indigo-100 transition-all">
                    Get Started
                </button>

                <button
                    class="flex items-center gap-3 border border-white/10 px-8 py-4 rounded-2xl font-bold hover:bg-white/5 transition-all">
                    Learn More
                </button>

            </div>

        </div>

        <!-- Right Side - Typebot -->
        <div class="glass h-[650px] w-full overflow-hidden relative shadow-2xl border-indigo-500/10">

            <typebot-standard typebot="lead-generation-lzwh3kq"
                style="width: 100%; height: 100%; border: none;">
            </typebot-standard>

        </div>

    </main>

    <!-- Metrics -->
    <section class="max-w-6xl mx-auto mt-24 grid grid-cols-2 md:grid-cols-4 gap-8 pb-20">

        <div class="text-center">
            <div class="text-4xl font-bold mb-1">24/7</div>
            <div class="text-gray-500 text-xs uppercase tracking-widest">
                Student Support
            </div>
        </div>

        <div class="text-center">
            <div class="text-4xl font-bold mb-1">Instant</div>
            <div class="text-gray-500 text-xs uppercase tracking-widest">
                Responses
            </div>
        </div>

        <div class="text-center">
            <div class="text-4xl font-bold mb-1">Secure</div>
            <div class="text-gray-500 text-xs uppercase tracking-widest">
                Communication
            </div>
        </div>

        <div class="text-center">
            <div class="text-4xl font-bold mb-1">AI</div>
            <div class="text-gray-500 text-xs uppercase tracking-widest">
                Powered
            </div>
        </div>

    </section>

    <!-- Typebot Script -->
    <script type="module">
        import Typebot from 'https://cdn.jsdelivr.net/npm/@typebot.io/js@0.3/dist/web.js'

        Typebot.initStandard({
            typebot: "lead-generation-lzwh3kq",
        });
    </script>

    <!-- Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>

</body>

</html>
